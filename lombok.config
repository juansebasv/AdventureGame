# Raíz de configuración de Lombok para el proyecto
config.stopBubbling = true

# Marca el código generado con @lombok.Generated (lo ignoran las herramientas de cobertura)
lombok.addLombokGeneratedAnnotation = true

# Copia estas anotaciones desde el campo hacia getters / parámetros de constructor generados,
# para que Jackson y Bean Validation sigan funcionando sobre clases inmutables (@Value).
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonProperty
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
